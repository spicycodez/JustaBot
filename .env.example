# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=ChatQuestBot

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chatquest
MONGODB_DB_NAME=chatquest

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Admin Configuration
ADMIN_IDS=123456789,987654321

# Bot Settings
XP_COOLDOWN=20
ANTI_SPAM_THRESHOLD=3
ANTI_SPAM_FREEZE_1=300
ANTI_SPAM_FREEZE_2=600
ANTI_SPAM_FREEZE_3=1800
MAX_DAILY_THANKS=5
REFERRAL_MIN_ACCOUNT_AGE_DAYS=7

# Season Configuration
SEASON_DURATION_DAYS=30

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
